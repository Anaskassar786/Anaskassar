# =========================================================
# SERVER-SIDE SECRETS (TRADING AI AK)
# Copy to .env.local — never commit real keys.
# =========================================================

# 1. NVIDIA API (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=minimaxai/minimax-m3

# 2. OPENROUTER API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-001

# 3. GOOGLE GEMINI API (Multimodal / Vision primary)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# 4. MINIMAX DIRECT / ROUTED CONFIG
MINIMAX_API_KEY=
MINIMAX_DEFAULT_MODEL=minimax-m3

# 5. TWELVE DATA (Market Time Series)
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# 6. FRED (Federal Reserve Economic Data)
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred

# 7. NEWS API (Financial & Macro News)
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org

# SYSTEM SECURITY & STORAGE
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_ai_ak
