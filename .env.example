# =========================================================
# SERVER-SIDE SECRETS (TRADING AI AK)
# Copy to .env.local — never commit real keys.
# =========================================================

# 1. NVIDIA API (OpenAI-compatible) — DEFAULT for vision, 10 agents, debate, judge
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=minimaxai/minimax-m3
# Retry the same key after a 429 across these models before giving up (optional).
# NVIDIA_FALLBACK_MODELS=
# Preference order. Any OTHER provider with a key is appended automatically as a
# failover tail (see LLM_FAILOVER below) — a single 429 can no longer kill the council.
LLM_PROVIDER_ORDER=nvidia

# 2. OPENROUTER API — failover (used automatically when a key is present)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Gemini 2.0 Flash is retired (404 / "no endpoints found"). Use 3.6+.
OPENROUTER_DEFAULT_MODEL=google/gemini-3.6-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-3.5-flash,google/gemini-2.5-flash
# Cap completion size. Unset max_tokens makes OpenRouter reserve 65k and 402 on small balances.
LLM_MAX_TOKENS=4096

# 3. GOOGLE GEMINI API (Multimodal / Vision fallback + LLM failover)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash

# 4. MINIMAX DIRECT / ROUTED CONFIG
MINIMAX_API_KEY=
MINIMAX_DEFAULT_MODEL=minimax-m3

# 5. TWELVE DATA (Market Time Series)
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# 6. FRED (Federal Reserve Economic Data)
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred

# 7. NEWS API (Financial & Macro News)
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org

# =========================================================
# RATE-LIMIT GOVERNOR (lib/llm/rate-limit.ts)
# Shared by vision + 10 specialists + debate + judge, so one free-tier 429 is a
# delay instead of a dead council. Defaults are tuned for an NVIDIA free key.
# =========================================================

# on = any other provider with a key is tried when the preferred one fails.
# off = strict single-provider behaviour (keep all spend on one account).
LLM_FAILOVER=on
# Minimum gap between two outbound LLM requests, process-wide (ms).
LLM_MIN_INTERVAL_MS=900
# Requests in flight at once. 1 = safest for free tiers; 3 is fine with paid keys.
LLM_MAX_CONCURRENCY=1
# Attempts per provider for retryable errors (429 / timeout / 5xx). 1-6.
LLM_MAX_ATTEMPTS=3
# Longest a single call waits for a Retry-After window before failing honestly.
LLM_MAX_WAIT_MS=90000
# Ceiling for one provider cooldown, whatever the API asked for.
LLM_MAX_COOLDOWN_MS=120000
# Consecutive provider-side failures before the breaker opens and stops the council.
LLM_OUTAGE_THRESHOLD=3
# Wall-clock budget for all LLM work in one run. Must stay below the route's
# maxDuration (300s) so the UI is never left spinning on a killed request.
LLM_RUN_BUDGET_MS=240000

# HOW MANY SPECIALISTS SHARE ONE REQUEST. This is the main defence against the
# free-tier 429 that used to report "COUNCIL OFFLINE - 10/10": at 5, the ten
# specialists cost 3 requests instead of 10, while each still answers
# independently in its own JSON object. Set 1 for the legacy one-call-per-agent
# behaviour, or 10 for the tightest possible quota use.
LLM_AGENT_BATCH_SIZE=5
# When a batch is rate limited, wait out the provider's own quoted Retry-After
# ONCE and retry before declaring an outage (bounded by LLM_RUN_BUDGET_MS).
LLM_RATE_LIMIT_RECOVERY=on
LLM_RATE_LIMIT_RECOVERY_MS=75000

# Per-specialist request shape (smaller prompts = fewer 429s).
LLM_AGENT_MAX_TOKENS=2048
LLM_AGENT_TIMEOUT_MS=55000
LLM_MARKET_CANDLES=12
LLM_NEWS_ITEMS=5
# Send the chart image to the 8 chart-reading specialists? Set false to run a
# text-only council during a quota crunch (macro/news agents never get the image).
LLM_AGENTS_ATTACH_CHART=true
# Browser pre-flight keeps the longest screenshot edge at 1400px by default.
# Set NEXT_PUBLIC_LLM_IMAGE_MAX_EDGE only if your quota safely allows larger images.
NEXT_PUBLIC_LLM_IMAGE_MAX_EDGE=1400
# Images above this size are dropped from specialist prompts (text-only run) so a
# 5MB PNG cannot burn the whole token budget in one agent.
LLM_IMAGE_MAX_BYTES=1500000
# Rejected uploads (> this) get a 413 with instructions instead of a 429 later.
MAX_UPLOAD_BYTES=12582912

# SYSTEM SECURITY & STORAGE
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL / RESERVED — this checkout persists sessions to the file-backed
# store under data/ (works with zero external services). If you prefer
# PostgreSQL/Supabase, run lib/db/schema.sql and point DATABASE_URL here.
DATABASE_URL=
