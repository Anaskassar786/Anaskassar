+    const url = 'postgresql://user:p%40ss%3Aword@host:5432/db?sslmode=require'
+    expect(normalizePostgresSslMode(url).connectionString).toBe('postgresql://user:p%40ss%3Aword@host:5432/db?sslmode=verify-full')
